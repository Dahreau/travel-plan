JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=changeme_dev_only
GITHUB_TOKEN=
SONAR_TOKEN=
SONARQUBE_DB_PASSWORD=changeme_dev_only

# Chemin ABSOLU de ce repo tel que vu par l'hôte (pas par le conteneur Jenkins).
# Nécessaire car le stage Deploy pilote le daemon Docker de l'hôte via le socket
# monté (docker-outside-of-docker) : le daemon résout les bind-mounts (vault-init,
# nginx) par rapport à SON PROPRE système de fichiers, pas celui de Jenkins.
# Exemple WSL2 : /mnt/d/Téléchargements/___Github___/JAVA_PROJECTS/travel-plan
HOST_REPO_PATH=/absolute/path/to/travel-plan
