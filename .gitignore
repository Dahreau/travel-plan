# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
*.pid
*.seed
*.pid.lock

# Environment files
.env
.env.local
.env.*.local

# Dependency directories
node_modules/
bower_components/

# Build directories
dist/
build/
out/
target/

# IDE files
.vscode/
.idea/
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.bak
*.orig
*.save

# Compiled files
*.class
*.o
*.so
*.dll
*.exe
*.pyc
*.pyo
*.pdb
*.app

# CI (Jenkins/SonarQube) — déjà couvert par la règle .env générique ci-dessus

# Copie de travail que Jenkins recrée à chaque Deploy pour que le daemon Docker
# de l'hôte (piloté via le socket monté) voie les fichiers à un vrai chemin hôte
infra/ci/deploy-workspace/

# Certificat TLS auto-signé Nginx (généré par Ansible, jamais commité)
# infra/nginx/certs/*.crt
# infra/nginx/certs/*.key
!infra/nginx/certs/.gitkeep
