POSTGRES_ADMIN_PASSWORD=changeme_dev_only
AUTH_DB_PASSWORD=changeme_dev_only
USER_DB_PASSWORD=changeme_dev_only
TRAVEL_DB_PASSWORD=changeme_dev_only
PAYMENT_DB_PASSWORD=changeme_dev_only
NEO4J_PASSWORD=changeme_dev_only
DEFAULT_ADMIN_PASSWORD=changeme_dev_only

# Vault tourne en mode serveur réel (stockage persistant, TLS), plus en mode dev.
# Laisse vide ici : ansible/playbooks/vault-unseal.yml initialise Vault au premier
# lancement (une seule fois) et écrit le vrai root token ici automatiquement.
VAULT_ROOT_TOKEN=

# Identifiants sandbox Stripe/PayPal — remplace par tes vraies clés de test
# (Stripe Dashboard > Developers > API keys ; PayPal Developer > Apps).
# Ecrits dans Vault une seule fois par vault-init, au premier bootstrap.
STRIPE_SECRET_KEY=sk_test_changeme_dev_only
PAYPAL_CLIENT_ID=changeme_dev_only
PAYPAL_CLIENT_SECRET=changeme_dev_only

# Identifiants AppRole par service — laisse vide ici. Rempli automatiquement
# par le playbook Ansible ansible/playbooks/fetch-vault-secrets.yml une fois
# la stack démarrée (vault-init a besoin d'avoir tourné avant).
API_GATEWAY_ROLE_ID=
API_GATEWAY_SECRET_ID=
AUTH_SERVICE_ROLE_ID=
AUTH_SERVICE_SECRET_ID=
USER_SERVICE_ROLE_ID=
USER_SERVICE_SECRET_ID=
TRAVEL_SERVICE_ROLE_ID=
TRAVEL_SERVICE_SECRET_ID=
PAYMENT_SERVICE_ROLE_ID=
PAYMENT_SERVICE_SECRET_ID=

# Optionnel : ports publiés sur l'host pour nginx (seul point d'entrée exposé —
# postgres/neo4j/vault/zipkin ne sont plus publiés du tout, accessibles
# uniquement depuis le réseau Docker interne). Laisser vide/absent = 80/443.
# NGINX_HTTP_HOST_PORT=80
# NGINX_HTTPS_HOST_PORT=443
